    // imp question
    public static void spiral(int [][]arr) {
        int i=0; 
        int j=0; 
        for(j=0; j<arr[i].length; j++){
            System.out.print(arr[i][j]+" ");
        }
        
        j= arr.length-1;
        for(i=1; i<arr[0].length; i++){
            System.out.print(arr[i][j]+" ");
        }
        i = arr.length-1;
        for(j=arr.length-2; j>=0; j--){
            System.out.print(arr[i][j]+" ");
        }
        
        j=0;
        for(i=arr.length -2; i>=1; i--){
            System.out.print(arr[i][j]+" ");
        } 
    }

    public static void spril2(int [] [] arr) {
        int l=0;
        int r=arr[0].length-1;
        int t=0;
        int b=arr.length-1;

        while (l<=r && t<= b) {
            for(int i=l; i<=r; i++ ){
                System.out.print(arr[t][i]+" ");
            }t++;
            for(int i=t; i<=b; i++ ){
                System.out.print(arr[i][r]+" ");
            }r--;
            for(int i=r; i>=l; i-- ){
                System.out.print(arr[b][i]+" ");
            }b--;
            for(int i=b; i>=t; i-- ){
                System.out.print(arr[i][l]+" ");
            }l++;
        }
    }
