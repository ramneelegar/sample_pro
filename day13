import java.util.Arrays;

public class day13 {
    public static void main(String[] args) {
        int  n = 4;
        int [] arr = new int[n+1];
        Arrays.fill(arr, -1);

        int [] jumps = {2, 3, 1};

        System.out.println(noofwaysMemorization(n, arr, jumps));
        System.out.println(noofwaysTabulation(n, jumps));
    }

    public static int noofwaysMemorization(int n, int [] arr, int [] jumps){
        if(arr[n]==-1){
            if(n==0 || n==1 ){
                arr[n] = 1;
            }
            else{
                int total =0;
                for(int i=0; i<jumps.length; i++){
                    if(n-jumps[i]>=0){
                        total += noofwaysMemorization(n-jumps[i], arr, jumps);
                    }
                }
                arr[n] = total;
            }
        }
        return arr[n];  
    }
}
