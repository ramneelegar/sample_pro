class node{
    int data;
    node next;  
    node(int data){
        this.data = data;
        next = null;
    }
}


class linkedlist2{
    node head ;

    // for printing  all ele of LL
    void printlist(){
        node curr = head;

        //  traversing the the entire linked list
        while(curr != null){
            System.out.println(curr.data);
            curr = curr.next;
        }
    }

    void add(int ele){
        node temp = new node(ele);
        if(this.head == null){
            this.head = temp;
        }else{
            node curr = this.head;
            while(curr.next != null){  // curren.next becz we want address to be null
                curr = curr.next;
            }
            curr.next = temp;
        }
    }

    void addfirst(int ele){
        node temp = new node(ele);
        if(this.head == null){
            head = temp;
        }else{
            temp.next = this.head;  // giving the address of head to temp.next
            this.head = temp;
        }
    }

    void addlast(int ele){
        node temp = new node(ele);
        if(this.head == null){
            head = temp;
        }else{
            node curr =head;
            while(curr.next != null){  
                curr = curr.next;
            }
            curr.next = temp;
        }
    }

    void addatindex(int index, int ele){
        try{
            node temp = new node(ele);
            int i = 0;
            node curr = head;
            while(i < index-1){
                curr = curr.next;
                i++;
            }
            temp.next = curr.next;
            curr.next = temp;
        } 
        catch (Exception e) {
            System.out.println("Invalid index");
        }
    }

    void addall(int [] arr){
        for(int ele:arr){
            add(ele);
        }
    }

}
